# Variables del backend (FastAPI). Copia este archivo a `.env` y complétalo.
# NUNCA subas `.env` a git: la service role key salta el RLS y ve todos los restaurantes.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Agente (todavía no se usa)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
